# Cabeceras de seguridad del Portal Consejos Escolares.
# Este archivo se copia a out/ en cada build (vive en public/).
# Replica las cabeceras ya configuradas en el servidor y agrega la CSP,
# de modo que la configuracion quede versionada en el repo.
<IfModule mod_headers.c>
	# CSP: solo scripts/estilos propios ('unsafe-inline' es requisito del export
	# estatico de Next: inyecta scripts inline de hidratacion sin nonce posible).
	# connect-src limita todo fetch/XHR al propio origen y a Supabase, lo que
	# corta la exfiltracion del token de sesion aunque se inyectara un script.
	# img-src incluye data:/blob: por html2canvas y jspdf (exportes del portal).
	Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://csxgnabxblkqkgpxcpyw.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; manifest-src 'self'"

	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
	Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
	Header always set X-Permitted-Cross-Domain-Policies "none"
	Header always set X-Download-Options "noopen"
</IfModule>
